{
  "name": "ai-motion-graphics-reel",
  "version": "1.0.0",
  "description": "Cinematic 3D AI Motion Graphics Instagram Reel in Remotion (1080x1920, 30fps)",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite --host 0.0.0.0 --port 3000",
    "dev": "vite --host 0.0.0.0 --port 3000",
    "studio": "remotion studio",
    "render": "node scripts/render-mp4.mjs",
    "render:remotion": "remotion render src/index.js AIMotionReel out/ai-motion-graphics-reel.mp4",
    "verify": "node scripts/verify-project.mjs",
    "audio:build": "python3 scripts/generate_audio_assets.py"
  },
  "dependencies": {
